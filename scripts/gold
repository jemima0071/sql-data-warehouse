/*
===============================================================================
DDL Script: Create Gold Layer Views
===============================================================================

Script Purpose:
    This script creates the Gold Layer views for the data warehouse.

    The Gold Layer represents the final business-ready data model designed
    for reporting, analytics, and dashboarding. It follows a Star Schema
    architecture consisting of dimension and fact tables that provide a
    consolidated and enriched view of the business data.

    The views are built using cleansed and standardized data from the
    Silver Layer and are structured to support efficient querying,
    self-service analytics, and business intelligence solutions.

    Data Mart Components:
        - DimCustomer : Customer dimension containing demographic and
                        customer-related attributes.
        - DimProduct  : Product dimension containing product hierarchy
                        and classification details.
        - FactSales   : Fact table containing sales transactions and
                        business measures.

Usage:
    - Query the Gold Layer views directly for reporting and analytics.
    - Consume the views in Power BI, Fabric, or other BI tools.
    - Support KPI tracking, trend analysis, customer analytics, and
      product performance reporting.

===============================================================================
*/

---------------------------------
--GOLD DIM_CUSTOMER--------------
CREATE VIEW gold.dim_customer  AS
select row_number () over (order by cst_id) as customer_key,
	ci.cst_id as customer_id,
	ci.cst_key as customer_number,
	ci.cst_firstname as first_name,
	ci.cst_lastname as last_name,
	ci.cst_marital_status as marital_status,
	ci.cst_create_date as create_date,
	ca.bdate as birthdate,
	case when ci.cst_gndr != 'N/A' then ci.cst_gndr
	else coalesce (ca.gen , 'N/A')
	end as gender,
	cl.CNTRY as country
from silver.crm_cust_info ci
left join silver.erp_cust_az12 ca
on ci.cst_key = ca.CID
left join silver.erp_loc_a101 cl
on ci.cst_key = cl.CID
WHERE ci.cst_id IS NOT NULL;
-----------------------------------
-----------------------------------
--2.gold.Product dimentions----
CREATE VIEW gold.dim_product  AS
select ROW_NUMBER() over (order by prd_id) as product_key,
pd.prd_id as product_id,
pd.prd_key as product_number,
pd.prd_nm as product_name,
pd.cat_id as category_id,
pc.CAT as category,
pc.SUBCAT as sub_category,
pc.MAINTENANCE as maintenance,
pd.prd_cost as product_cost,
pd.prd_line as product_line,
pd.prd_start_dt	 as start_date
from silver.crm_prd_info pd
left join silver.erp_px_cat_g1v2 pc
on pd.cat_id = pc.ID

--------------------------------------------
---3. FACT_SALES_DETAILS------------------
create view gold.fact_sales as
Select
sd.sls_ord_num as order_number,
pd.product_key,
cu.customer_key,
sd.sls_order_dt as order_date,
sd.sls_ship_dt as ship_date,
sd.sls_due_dt as due_date,
sd.sls_sales as sales,
sd.sls_quantity as quanitity,
sd.sls_price as price
from silver.crm_sales_details sd
left join gold.dim_product pd
on sd.sls_prd_key = pd.product_number
left join gold.dim_customer cu
on  cu.customer_id = sd.sls_cust_id
