-- check for dimensions to make sure no duplicates while joining
select prd_key, count(*) from
(
select 
pd.prd_id,
pd.cat_id,
pd.prd_key,
pd.prd_nm,
pd.prd_cost,
pd.prd_line,
pd.prd_start_dt,
pc.CAT,
pc.SUBCAT,
pc.MAINTENANCE	
from silver.crm_prd_info pd
left join silver.erp_px_cat_g1v2 pc
on pd.cat_id = pc.ID
)t group by prd_key
having count(*) > 1


